/*
=============================================================================
Test : Quality Check
=============================================================================
Script Purpose:
	This script performs various quality checks for data consistency, accuracy,
	and standardization across the 'silver' schemas. It includes checks for:
	- Null or duplicate primary keys.
	- Unwanted spaces in string fields.
	- Data standardization and consistency.
	- Invalid date ranges and orders.
	- Data consistency between related fields.

Usage Notes:
	- Run these checks after data loading Silver Layer.
	- Investigate and resolve any discrepancies found during the checks.
=============================================================================
*/

-- ---------------------------------------------
-- CRM table australia
-- ---------------------------------------------

SELECT * FROM silver.crm_australia
WHERE Revenue  < 100; 

TRUNCATE TABLE silver.crm_australia;
INSERT INTO silver.crm_australia
    (
    ProductID, 
    Date ,
    Zip ,
    Units ,
    Revenue ,
    Country,
    dwt
    )
SELECT 
    ProductID, 
    Date ,
    Zip ,
    Units ,
    Revenue ,
    Country,
    GETDATE()
FROM  bronze.crm_australia; 

-- Data Quality Check

-- Duplicate Check
-- Expected No duplicate
WITH duplicate_check AS(
SELECT 
    *,
    ROW_NUMBER() OVER(PARTITION BY Date, ProductID, Zip ORDER BY Zip) AS dup_flag
FROM  bronze.crm_australia)  
SELECT * FROM duplicate_check
WHERE dup_flag = 2;
/*Based on the business rules we applied, there is no enough eveidence to flag rows 
of dup_flag column that have number greater or equal to 2. 
Cross check revealed that people who bought the same and have same Zip could not be same 
*/

-- Checking Missing value for ProductID
-- Expected result : No missing value
SELECT 
    COUNT(*) AS total_record, 
    COUNT(ProductID) AS count_productid,
    COUNT(*) - COUNT(ProductID)
FROM  bronze.crm_australia; 

-- Checking Null value for ProductID
-- Expected rsult : No null
SELECT *
FROM  bronze.crm_australia 
WHERE  ProductID IS NULL OR ProductID = ''; 

-- Checking Null value for Date
-- Expected rsult : No null
SELECT *
FROM  bronze.crm_australia 
WHERE Date IS NULL ; 

-- Checking Date Scope
SELECT 
    MIN(Date) AS earliest_date,
    MAX(Date) AS latest_date,
    GETDATE() AS cureent_date
FROM  bronze.crm_australia 

-- Checking Inconsistency Date
-- Expected : NO 
SELECT *
FROM  bronze.crm_australia 
WHERE Date > GETDATE() ;

-- Checking Null value for Zip
-- Expected rsult : No null
SELECT *
FROM  bronze.crm_australia 
WHERE Zip  IS NULL OR Zip = ''; 

-- Checking Null value for Units
-- Expected rsult : No null
SELECT *
FROM  bronze.crm_australia 
WHERE Units  IS NULL OR Zip = ''; 

-- Checking quantity distribution and missing values
-- Expected : Normal distribution and missing value
SELECT 
    COUNT(*) AS total_record, 
    COUNT(Units) AS count_units
FROM  bronze.crm_australia; 

-- Checking Inconsistency for Units 
-- Expected : NO 
SELECT *
FROM  bronze.crm_australia 
WHERE Units < 0

-- Checking min and max quantity sold 
SELECT 
    MIN(Units) highest_quantity_sold,
    MAX(Units) lowest_quantity_sold
FROM  bronze.crm_australia 
 
-- Checking Revenue distribution and missing values
-- Expected : Normal distribution and missing value
SELECT 
    COUNT(*) AS total_record, 
    COUNT(Revenue) AS count_Revenue
FROM  bronze.crm_australia; 

-- Checking Inconsistency for Revenue 
-- Expected : NO 
SELECT *
FROM  bronze.crm_australia 
WHERE Revenue < 0

-- Checking min and max quantity sold 
SELECT 
    MIN(Revenue) highest_quantity_sold,
    MAX(Revenue) lowest_quantity_sold
FROM  bronze.crm_australia 

-- Checking Inconsistency for Country 
-- Expected : NO 
SELECT 
    DISTINCT Country,
    ISNULL(Country, 'N/A') 
FROM  bronze.crm_australia 

SELECT *
FROM  bronze.crm_australia 
WHERE TRIM(Country)  <> Country or Country IS NULL OR Country = '' 

