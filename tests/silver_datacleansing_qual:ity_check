-- ERP table products
-- ---------------------------------------------
-- Duplicates check
-- Expected result : no duplicates 
SELECT * 
FROM(
SELECT 
        ProductID 
      , COUNT(*) total_record
FROM  bronze.erp_products 
GROUP BY 
        ProductID) flag_duplicates
WHERE total_record > 1  

-- Standardize column product
SELECT 
    MAX(number),
    MIN(number)
FROM(
SELECT 
    Distinct Product,
    LEN(Product) AS number
FROM  bronze.erp_products) TTT

-- Spilt column product name and subcategory
SELECT
Product,
CASE 
    WHEN Product LIKE '%Leo%' THEN SUBSTRING(Product,1,9)
    WHEN Product LIKE  '%Fama%' THEN SUBSTRING(Product,1,10) 
    WHEN Product LIKE '%Pomum%' THEN SUBSTRING(Product,1,11)
    WHEN Product LIKE  '%Palma%' OR Product LIKE  '%Pirum%' OR Product LIKE '%Abbas%' THEN SUBSTRING(Product,1,11) 
    WHEN Product LIKE '%Currus%'OR Product LIKE  '%Natura%' OR Product LIKE '%Aliqui%' 
        OR Product LIKE  '%Quibus%' OR Product LIKE  '%Salvus%' THEN SUBSTRING(Product,1,12) 
    WHEN Product LIKE '%Maximus%' OR Product LIKE  '%Maximus%' THEN SUBSTRING(Product,1,13) 
END AS product_name,
CASE 
    WHEN Product LIKE '%Leo%' THEN SUBSTRING(Product,11,LEN(Product))
    WHEN Product LIKE '%Fama%' THEN SUBSTRING(Product,12,LEN(Product))
    WHEN Product LIKE '%Pomum%' OR Product LIKE '%Abbas%' OR Product LIKE '%Palma%' 
        OR Product LIKE '%Pirum%' THEN SUBSTRING(Product,13,LEN(Product))
    WHEN Product LIKE '%Aliqui%' OR Product LIKE '%Currus%' OR Product LIKE '%Natura%' 
        OR Product LIKE '%Quibus%' OR Product LIKE '%Salvus%' THEN SUBSTRING(Product,14,LEN(Product))
    WHEN Product LIKE '%Maximus%' OR Product LIKE '%Maximus%' THEN SUBSTRING(Product,15,LEN(Product))
END AS Subcategory
FROM bronze.erp_products 
 
-- Standardize column price 
SELECT 
Price,
SUBSTRING(Price,1,3) AS Currency,
SUBSTRING(Price,5,LEN(Price)) AS Unit_Price
FROM bronze.erp_products 


