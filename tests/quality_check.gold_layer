
/*
	Fact sales combines seven tables of seven different countries. 
	six tables from crm (australia, canada, germany, japan, mexico, nigeria and 
	one table from erp (sales of the usa).  
*/
SELECT 
	ProductID AS product_id,
	Date AS order_date,
	CAST(Zip AS NVARCHAR) AS zip,
	Units AS quantity,
	Revenue AS revenue,
	Country AS country
FROM silver.crm_australia
	UNION ALL 
SELECT 
	ProductID ,
	Date,
	CAST(Zip AS NVARCHAR),
	Units,
	Revenue,
	Country
FROM silver.crm_canada
	UNION ALL 	
SELECT  
	ProductID,
	Date,
	CAST(Zip AS NVARCHAR),
	Units,
	Revenue,
	Country
FROM silver.crm_germany
	UNION ALL 
SELECT 
	ProductID,
	Date,
	CAST(Zip AS NVARCHAR),
	Units,
	Revenue,
	Country 
FROM silver.crm_japan
	UNION ALL 
SELECT 
	ProductID,
	Date,
	CAST(Zip AS NVARCHAR),
	Units,
	Revenue,
	Country 
FROM silver.crm_mexico
	UNION ALL  
SELECT 
	ProductID,
	Date,
	CAST(Zip AS NVARCHAR),
	Units,
	Revenue,
	Country 
FROM silver.crm_nigeria
	UNION ALL  
SELECT 
	ProductID,
	Date,
	CAST(Zip AS NVARCHAR),
	Units,
	Revenue,
	Country 
FROM silver.erp_sales

/*
	Dimension table locations
*/

SELECT
	Zip AS zip, 
	District AS district, 
	City AS city,
	Region AS region,
	State AS country_state, 
	Country AS country
FROM  silver.erp_geo 

/*
	Dimension table mafucturers
*/

SELECT
	ManufacturerID AS manufacturer_id, 
	Manufacturer AS manufacturer_name,
	Logo AS manufacturer_logo
FROM  silver.erp_manufacturers 

/*
	Dimension table products
*/

SELECT
	ProductID AS product_id, 
	ManufacturerID AS manufacturer_id,
	Product_name AS product_name, 
	Subcategory AS subcategory, 
	Category AS category,  
	Unit_Price AS unit_price,
	Currency AS currency
FROM silver.erp_products 








