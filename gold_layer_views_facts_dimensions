/*
======================================================================
Create Gold Layer Views
======================================================================

Script irpose;
	This script creates views for the Gold layer in the data warehouse.
	The Gold layer represents the final dimension and fact tables (Star Schema)

	Each view performs transformations and combines data from the Silver layer
	to produce a clean, enriched, and business-ready dataset.


=======================================================================
*/

-- ====================================================================
-- Create Dimension : gold.dim_products 
-- ====================================================================
CREATE VIEW gold.dim_products AS 
SELECT
	ProductID AS product_id, 
	ManufacturerID AS manufacturer_id,
	Product_name AS product_name, 
	Subcategory AS subcategory, 
	Category AS category,  
	Unit_Price AS unit_price,
	Currency AS currency
FROM silver.erp_products 

-- ====================================================================
-- Create Dimension : gold.dim_manufactures 
-- ====================================================================
CREATE VIEW gold.dim_manufactures AS 
SELECT
	ManufacturerID AS manufacturer_id, 
	Manufacturer AS manufacturer_name,
	Logo AS manufacturer_logo
FROM  silver.erp_manufacturers 

-- ====================================================================
-- Create Dimension : gold.dim_locations 
-- ====================================================================
CREATE VIEW gold.dim_locations AS 
SELECT
	Zip AS zip, 
	District AS district, 
	City AS city,
	Region AS region,
	State AS country_state, 
	Country AS country
FROM  silver.erp_geo 

/*
-- ====================================================================
-- Create Fact : gold.fact_sales 

		Fact sales combines seven tables of seven different countries. 
		six tables from crm (australia, canada, germany, japan, mexico, 
		nigeria and one table from erp (sales of the usa). 
-- ====================================================================
*/
SELECT 
	ProductID AS product_id,
	Date AS order_date,
	CAST(Zip AS NVARCHAR) AS zip,
	Units AS quantity,
	Revenue AS revenue,
	Country AS country
FROM silver.crm_australia
	UNION ALL 
SELECT 
	ProductID ,
	Date,
	CAST(Zip AS NVARCHAR),
	Units,
	Revenue,
	Country
FROM silver.crm_canada
	UNION ALL 	
SELECT  
	ProductID,
	Date,
	CAST(Zip AS NVARCHAR),
	Units,
	Revenue,
	Country
FROM silver.crm_germany
	UNION ALL 
SELECT 
	ProductID,
	Date,
	CAST(Zip AS NVARCHAR),
	Units,
	Revenue,
	Country 
FROM silver.crm_japan
	UNION ALL 
SELECT 
	ProductID,
	Date,
	CAST(Zip AS NVARCHAR),
	Units,
	Revenue,
	Country 
FROM silver.crm_mexico
	UNION ALL  
SELECT 
	ProductID,
	Date,
	CAST(Zip AS NVARCHAR),
	Units,
	Revenue,
	Country 
FROM silver.crm_nigeria
	UNION ALL  
SELECT 
	ProductID,
	Date,
	CAST(Zip AS NVARCHAR),
	Units,
	Revenue,
	Country 
FROM silver.erp_sales






