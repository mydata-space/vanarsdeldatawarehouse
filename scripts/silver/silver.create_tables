/*
========================================================
Silver Layer Tables
========================================================
Script Purpose:
	This script create tables for silver layer. It checks
	if the table already exist then create a new tables
	in the DataBase 'vanarsdelwarehouse'.

	furthermore, dwt metadata was added to track date and
	time of loading data  into tables. 

========================================================
*/

-- -------------------------
-- CRM
-- -------------------------
IF OBJECT_ID('silver.crm_australia','U') IS NOT NULL
	DROP TABLE silver.crm_australia;
CREATE TABLE silver.crm_australia
	(
	ProductID INT,
	Date DATE,
	Zip INT,
	Units INT,
	Revenue DECIMAL(12,2),
	Country NVARCHAR(50),
	dwt DATETIME 
	);

